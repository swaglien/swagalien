{
  "name": "nutrition-tracker",
  "version": "1.0.2",
  "description": "A local nutrition tracker for Windows and the web.",
  "main": "main.js",
  "author": "Finn",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.finn.nutritiontracker",
    "productName": "Nutrition Tracker",
    "publish": {
      "provider": "github",
      "owner": "swaglien",
      "repo": "swagalien"
    },
    "files": [
      "index.html",
      "style.css",
      "script.js",
      "main.js",
      "preload.js",
      "supabase-config.js"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}